# Copy to `.env` next to docker-compose.yml and fill in what you use.
# Compose interpolates ${VAR:-default} from this file. Only octo-fiesta vars
# are listed; the other sidecars have no required env vars.

# ===== octo-fiesta =====
# Music service: SquidWTF (free, no credentials) | Deezer | Qobuz | Yandex
MUSIC_SERVICE=SquidWTF
# Cache = stream missing tracks without writing to the library;
# Permanent = save fetched tracks into the download folder (mount it into Navidrome)
STORAGE_MODE=Cache
CACHE_DURATION_HOURS=1
ENABLE_EXTERNAL_PLAYLISTS=true
PLAYLISTS_DIRECTORY=playlists
EXPLICIT_FILTER=All
DOWNLOAD_MODE=Track
AUTO_UPGRADE_QUALITY=false
DISABLE_LIBRARY_SCAN=false
# Folder template - braces are literal here (this value must NOT go inline in the
# compose, it would break interpolation).
FOLDER_TEMPLATE={artist}/{album}/{track} - {title}
# Admin creds - only needed for Permanent-mode library registration.
SUBSONIC_ADMIN_USERNAME=
SUBSONIC_ADMIN_PASSWORD=

# SquidWTF backends: Qobuz | Tidal | AmazonMusic | Deemix
SQUIDWTF_SOURCE=Qobuz
# Qobuz 27/7/6/5, Tidal HI_RES_LOSSLESS/LOSSLESS/HIGH/LOW, AmazonMusic FLAC_24/FLAC_16/AAC/OPUS/ATMOS, Deemix FLAC/MP3_320/MP3_128
SQUIDWTF_QUALITY=6
SQUIDWTF_INSTANCE_TIMEOUT=5
# Force a specific Tidal API instance (self-hosted hifi-api) - overrides InstancesUrl
SQUIDWTF_INSTANCE=
# Override URL of the remote instances.json (default: https://tidal-uptime.geeked.wtf/)
SQUIDWTF_INSTANCES_URL=

# ===== Octo-Fiesta providers (credentials - optional) =====
# Deezer (ARL token from your account; see octo-fiesta wiki)
DEEZER_ARL=
DEEZER_ARL_FALLBACK=
DEEZER_QUALITY=
# Qobuz (paid account)
QOBUZ_USER_AUTH_TOKEN=
QOBUZ_USER_ID=
QOBUZ_QUALITY=
# Yandex (OAuth token)
YANDEX_OAUTH_TOKEN=
YANDEX_QUALITY=
YANDEX_LANGUAGE=en
YANDEX_INCLUDE_UNAVAILABLE_TRACKS=false
